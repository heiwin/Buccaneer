{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Buccaneer",
  "version": "0.9.6.1",
  "identifier": "com.buccaneer.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Buccaneer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://image.tmdb.org https://placehold.co; connect-src 'self' https://api.themoviedb.org https://api.knaben.org https://apibay.org; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "buccaneer"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNTU4RkJDOTNBMkU5MTkKUldRWjZhS1R2STlWR2dEY3ZnN09xOW5mSmt2bFY4MTNPMytaRHJ4WGlpVyt3QmhQczQwTVN4aVoK",
      "endpoints": [
        "https://github.com/heiwin/Buccaneer/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}